# --- Database ---
# Local dev: leave as-is (creates a local SQLite file).
# Production: point at Postgres, e.g. Vercel Postgres / Supabase / Neon,
# and change the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe ---
# From https://dashboard.stripe.com/apikeys (use test keys first)
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# From https://dashboard.stripe.com/webhooks (see README for how to get this)
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Create these in Stripe Dashboard -> Product catalog -> add a recurring Price
STRIPE_PRICE_PRO_MONTHLY="price_xxx"
STRIPE_PRICE_PRO_YEARLY="price_xxx"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Optional: AI generator tools (Pro-only) ---
# Only needed if you turn on AI Image / AI Sound generation.
# Any of these providers work; pick one and wire it in app/api/generate/*.
OPENAI_API_KEY=""
REPLICATE_API_TOKEN=""
